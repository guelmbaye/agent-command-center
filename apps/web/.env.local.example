# URL du Control Plane ACC.
#
# Utiliser 127.0.0.1 et NON localhost : sous Windows, "localhost" résout
# d'abord en IPv6 (::1) alors qu'uvicorn n'écoute qu'en IPv4. Un service tiers
# lié à [::1]:8080 (Apache/XAMPP, IIS, proxy) intercepterait les appels.
NEXT_PUBLIC_ACC_API=http://127.0.0.1:8080

# Optionnel : uniquement si ACC_API_KEY est défini côté backend
NEXT_PUBLIC_ACC_API_KEY=

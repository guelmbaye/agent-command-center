# Systemes entreprise simules — service Cloud Run `acc-mock-enterprise`
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app

RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn[standard]>=0.32" "pydantic>=2.9"

COPY mock_enterprise/ ./mock_enterprise/

RUN useradd --create-home --uid 1001 acc && chown -R acc:acc /app
USER acc

ENV PORT=8080
EXPOSE 8080
CMD exec uvicorn mock_enterprise.main:app --host 0.0.0.0 --port ${PORT}

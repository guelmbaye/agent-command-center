# ============================================================================
# ACC — Autonomous Mission Control : configuration
# Aucun secret ici. En production : Secret Manager + Workload Identity.
# ============================================================================

ACC_ENV=local                  # local | dev | demo | production
ACC_LOG_LEVEL=INFO
ACC_API_PORT=8080

# --- Persistance -------------------------------------------------------------
ACC_PERSISTENCE=memory         # memory | firestore
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=europe-west1
FIRESTORE_DATABASE=(default)

# --- Bus d'evenements --------------------------------------------------------
ACC_EVENT_BUS=inproc           # inproc | pubsub
PUBSUB_TOPIC=acc-events
PUBSUB_PUSH_TOKEN=

# --- Flotte d'agents ---------------------------------------------------------
ACC_AGENT_MODE=deterministic   # adk | deterministic | hybrid
# EXIGENCE DU CONCOURS : Gemini 3.5 ou plus recent (obligatoire).
# 3.6 Flash : plus recent que 3.5 et moins cher (tarif promo jusqu'au 31/12/26).
GEMINI_MODEL=gemini-3.6-flash
# Modele du Failure Twin. VIDE = identique aux autres agents.
# Un modele « Pro » coute environ 4x plus cher : verifier le budget avant.
GEMINI_MODEL_REASONING=
GOOGLE_GENAI_USE_VERTEXAI=1
VERTEX_AI_LOCATION=europe-west1
ACC_AGENT_TIMEOUT_S=25

# --- Securite ----------------------------------------------------------------
ACC_MODEL_ARMOR=heuristic      # off | heuristic | gcp
MODEL_ARMOR_TEMPLATE=          # projects/X/locations/Y/templates/acc-guardrails
ACC_API_KEY=                   # protege le control plane (Cloud Run public)
ACC_DEMO_MODE=1                # 1 = expose /api/v1/demo/*

# --- Systemes entreprise (mock) ----------------------------------------------
ACC_ENTERPRISE_BASE_URL=http://localhost:8081

# --- Observabilite -----------------------------------------------------------
OTEL_SERVICE_NAME=acc-api
# none en local : le tracage de mission d'ACC fonctionne independamment.
# console/otlp/gcp activent en plus les spans HTTP automatiques.
OTEL_TRACES_EXPORTER=none      # none | console | otlp | gcp
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- CORS --------------------------------------------------------------------
# Origines exactes autorisees en mode cloud (liste separee par des virgules).
ACC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Les URLs Cloud Run ont un sous-domaine genere : elles passent par une regex.
ACC_CORS_ORIGIN_REGEX=https://acc-(web|api)-[a-z0-9-]+\.(a\.)?run\.app
